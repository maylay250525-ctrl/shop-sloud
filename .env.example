# Admin passcode (default is admin123 if not set — change it!)
ADMIN_PASSCODE=admin123
# Port Render assigns automatically (leave unset locally)
PORT=3000
# Persistent database (optional but strongly recommended for a real shop).
# If set, the app stores everything in Postgres instead of data/db.json,
# so orders / top-ups / wallets survive Render restarts and spin-downs.
# Get a FREE Postgres connection string from Neon (https://neon.tech)
# or Supabase (https://supabase.com) and paste it ONLY in the Render
# dashboard (Environment tab) — never commit a real URL to git.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
