# Admin passcode (default is admin123 if not set — change it!)
ADMIN_PASSCODE=admin123
# Signs customer login tokens (48h sessions). On Render this is
# auto-generated (render.yaml: AUTH_SECRET, generateValue: true).
# For local testing any value works; never commit a real secret.
# AUTH_SECRET=change-me-to-a-long-random-string
# Port Render assigns automatically (leave unset locally)
PORT=3000
# Persistent database (optional but strongly recommended for a real shop).
# If set, the app stores everything in Postgres instead of data/db.json,
# so orders / top-ups / wallets survive Render restarts and spin-downs.
# Get a FREE Postgres connection string from Neon (https://neon.tech)
# or Supabase (https://supabase.com) and paste it ONLY in the Render
# dashboard (Environment tab) — never commit a real URL to git.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Daily automatic backup token (backup download only). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACKUP_TOKEN=
# Email OTP (Gmail, free, 500/day): the address OTP codes are sent FROM,
# and its 16-char App Password (Google Account → Security → 2-Step
# Verification → App passwords). Both go in the Render dashboard, never
# in git. SMTP_* optionally overrides Gmail with another provider.
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Google login ("Sign in with Google"): OAuth 2.0 Web client ID from
# Google Cloud (APIs & Services → Credentials). Public value; the server
# also serves it to the shop page. Until set, the Google button is hidden.
# GOOGLE_CLIENT_ID=xxxxxx.apps.googleusercontent.com
